# Copy to .env.local and fill in. Never commit real secrets.
# Empty values count as unset. Validated by src/lib/env.ts.

LOG_LEVEL=info

DATABASE_URL=                # Neon pooled connection
DATABASE_URL_UNPOOLED=       # for migrations / transactions

LLM_PROVIDER=replay          # anthropic | ollama | replay
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
LLM_DAILY_CALL_CAP=150

RATE_LIMIT_LIVE_PER_HOUR=10
RATE_LIMIT_SUBMIT_PER_DAY=30

INBOUND_WEBHOOK_SECRET=
CRON_SECRET=
IP_HASH_SALT=

LEGACY_BASE_URL=http://localhost:3000/legacy
LEGACY_USER=
LEGACY_PASSWORD=
LEGACY_SESSION_SECRET=       # >= 32 chars, e.g. `openssl rand -hex 32`
BROWSER_WS_ENDPOINT=         # only for the hosted-browser fallback
